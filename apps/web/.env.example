# Apex host of the drop service. Subdomains of this host are served as sites.
# Local dev: localhost:3000  (visit foo.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=site.pakhale.com

# Shared secret required to publish, prune, or delete a site. Fail-closed: if
# unset, every write endpoint returns 503. Use something long and random:
#   openssl rand -hex 32
DROP_PASSWORD=

# Provided automatically once you attach a Blob store to the Vercel project.
#
# Locally, `vercel env pull` also writes VERCEL_OIDC_TOKEN and BLOB_STORE_ID.
# The SDK prefers OIDC whenever BLOB_STORE_ID is set, and OIDC has to be enabled
# per environment, so `bun run dev` fails with "OIDC is enabled for this project,
# but not for the development environment". Either enable Secure Backend Access
# for Development, or blank BLOB_STORE_ID in .env.development.local to fall back
# to the token below.
BLOB_READ_WRITE_TOKEN=

# Optional. Public origin of the Blob store, e.g.
#   https://xxxxxxxx.public.blob.vercel-storage.com
# Left unset, it is derived once at runtime from the store's first blob and
# cached. Set it explicitly to save that lookup on a cold start.
BLOB_BASE_URL=

# The CLI does not read this file. It takes --endpoint/--password, or
# SITEDROP_ENDPOINT and SITEDROP_PASSWORD from the environment (the repo-root
# .env.local works for `bun run drop`).
